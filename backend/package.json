{
  "name": "phamsag-backend",
  "version": "1.0.0",
  "description": "Past Questions & Academic Resource Platform for Pharmacy Students",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --exec node src/server.js",
    "dev:debug": "nodemon --exec node --inspect src/server.js",
    "seed": "node src/seed/seedCourses.js",
    "seed:users": "node src/seed/seedAdmin.js",
    "seed:all": "node src/seed/seedCourses.js && node src/seed/seedAdmin.js",
    "clean": "node src/scripts/cleanDatabase.js",
    "reset": "npm run clean && npm run seed:all",
    "test": "echo \"No tests yet\"",
    "lint": "npx eslint src/",
    "format": "npx prettier --write src/"
  },
  "keywords": [
    "pharmacy",
    "education",
    "backend",
    "mern",
    "university"
  ],
  "author": "PHAMSAG Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^2.2.1",
    "pino": "^8.16.1",
    "pino-pretty": "^10.2.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
